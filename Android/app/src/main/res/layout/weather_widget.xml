<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/weather_widget_background" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Weather" android:textColor="#F6F7F9" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="↻" android:textColor="#00DFB3" android:textSize="20sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to choose location" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:id="@+id/widget_symbol" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☀" android:textColor="#00DFB3" android:textSize="28sp" />
        <TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="28sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_condition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open-Meteo weather" android:textColor="#AAB3BF" android:textSize="12sp" />
    <TextView android:id="@+id/widget_metrics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity · Wind" android:textColor="#F6F7F9" android:textSize="12sp" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Updated now" android:textColor="#00DFB3" android:textSize="10sp" android:layout_marginTop="4dp" />
</LinearLayout>
